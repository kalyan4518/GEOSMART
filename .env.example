# Copy this file to .env and replace the placeholders as needed.
SECRET_KEY=generate-a-long-random-value
ADMIN_EMAIL=admin@geosmart.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Defaults to a local SQLite database in the project root.
# For PostgreSQL, use: postgresql+psycopg2://user:password@host:5432/database
# DATABASE_URL=sqlite:///geosmart.db

# Optional model weights (absolute paths or paths relative to the project root).
# GEOSMART_MODEL_PATH=models/waste_model.pt
# GEOSMART_CNN_MODEL_PATH=models/waste_cnn.h5

# Optional tuning values; shown defaults are used if omitted.
# HOTSPOT_CLUSTER_EPS_METERS=250
# HOTSPOT_MIN_POINTS=1
# VERIFIED_THRESHOLD=0.5
# RESPONSE_SPEED_KMPH=24
